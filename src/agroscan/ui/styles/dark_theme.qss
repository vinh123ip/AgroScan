/* Reset cơ bản */
QWidget {
    font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", "Segoe UI Symbol", sans-serif;
}

/* ====================================================
   MAIN LAYOUT & SIDEBAR
   ==================================================== */

QMainWindow {
    background-color: #0F172A; /* Nền tối xanh đen (Slate 900) */
}

/* Sidebar */
#Sidebar {
    background-color: #0B1121; /* Tối hơn content một chút (Slate 950) */
    border-right: 1px solid #1E293B;
}

#Brand {
    font-size: 30px;
    font-weight: 900;
    color: #F8FAFC;
    letter-spacing: -1px;
}

#BrandSubtitle {
    font-size: 11px;
    font-weight: bold;
    color: #38BDF8; /* Sky 400 */
    letter-spacing: 1.5px;
}

/* Navigation List */
#Navigation {
    background-color: transparent;
    border: none;
    outline: none;
}

#Navigation::item {
    height: 46px;
    border-radius: 8px;
    color: #94A3B8;
    font-size: 15px;
    font-weight: 500;
    padding-left: 16px;
    margin-bottom: 6px;
}

#Navigation::item:hover {
    background-color: #1E293B;
    color: #F1F5F9;
}

#Navigation::item:selected {
    background-color: #38BDF8; /* Accent color */
    color: #0B1121;
    font-weight: bold;
}

/* Footer Badge */
#DemoBadge {
    background-color: #1E293B;
    color: #94A3B8;
    font-size: 11px;
    font-weight: bold;
    padding: 10px 16px;
    border-radius: 6px;
    letter-spacing: 1.2px;
}

/* ====================================================
   HEADER & CONTENT
   ==================================================== */

#Content {
    background-color: #0F172A;
}

#Header {
    background-color: #0F172A;
    border-bottom: 1px solid #1E293B;
}

#Breadcrumb {
    font-size: 14px;
    font-weight: 500;
    color: #64748B;
}

#UserLabel {
    font-size: 13px;
    font-weight: bold;
    color: #F8FAFC;
    background-color: #1E293B;
    padding: 8px 20px;
    border-radius: 16px;
}

/* ====================================================
   DASHBOARD PAGE
   ==================================================== */

#DashboardPage {
    background-color: #0F172A;
}

#PageTitle {
    font-size: 42px;
    font-weight: bold;
    color: #F8FAFC; 
    letter-spacing: -0.5px;
}

#PageSubtitle {
    font-size: 16px;
    color: #94A3B8; 
}

/* Thẻ thống kê (Card) */
#StatCard {
    background-color: #1E293B; 
    border-radius: 16px;
    border: 1px solid #334155; 
}

#StatCard:hover {
    background-color: #273449; 
    border: 1px solid #475569;
}

#CardTitle {
    font-size: 13px;
    font-weight: bold;
    color: #94A3B8;
    letter-spacing: 1.2px;
}

#CardValue {
    font-size: 48px;
    font-weight: 800;
    color: #38BDF8; 
}

#CardNote {
    font-size: 14px;
    font-weight: 500;
    color: #94A3B8;
}

/* ====================================================
   LOADING SCREEN
   ==================================================== */

#LoadingContainer {
    background-color: #0F172A;
}

#LoadingCard {
    background-color: #1E293B;
    border: 1px solid #334155;
    border-radius: 20px;
}

#LoadingTitle {
    font-size: 22px;
    font-weight: 700;
    color: #F8FAFC;
    letter-spacing: -0.3px;
}

#LoadingStatus {
    font-size: 13px;
    font-weight: 500;
    color: #38BDF8;
}

#LoadingProgressBar {
    background-color: #0F172A;
    border: 1px solid #334155;
    border-radius: 4px;
    text-align: center;
    color: transparent;
    height: 8px;
}

#LoadingProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #0284C7, stop:1 #38BDF8);
    border-radius: 3px;
}

#LoadingSubtitle {
    font-size: 13px;
    font-weight: 500;
    color: #94A3B8;
}

/* ====================================================
   NEW INSPECTION PAGE (M2.1)
   ==================================================== */

#NewInspectionPage {
    background-color: #0F172A;
}

#PageScrollArea {
    background-color: transparent;
    border: none;
}

#ScrollContent {
    background-color: transparent;
}

/* Form card container */
#FormCard {
    background-color: #1E293B;
    border: 1px solid #334155;
    border-radius: 16px;
}

/* Section titles inside the card */
#FormSectionTitle {
    font-size: 13px;
    font-weight: 700;
    color: #38BDF8;
    letter-spacing: 1.2px;
}

/* Form field labels */
#FormLabel {
    font-size: 14px;
    font-weight: 500;
    color: #CBD5E1;
    min-width: 148px;
}

/* Text input fields */
#FormField,
#ReadOnlyField,
#NotesField {
    background-color: #0F172A;
    border: 1px solid #334155;
    border-radius: 8px;
    color: #F1F5F9;
    font-size: 14px;
    padding: 10px 14px;
    selection-background-color: #38BDF8;
    selection-color: #0F172A;
}

#FormField:focus,
#NotesField:focus {
    border: 1px solid #38BDF8;
    background-color: #0B1828;
}

#FormField:hover,
#NotesField:hover {
    border: 1px solid #475569;
}

/* Read-only session ID field */
#ReadOnlyField {
    color: #64748B;
    background-color: #0B1121;
    border: 1px solid #1E293B;
}

/* Combo box */
#FormCombo {
    background-color: #0F172A;
    border: 1px solid #334155;
    border-radius: 8px;
    color: #F1F5F9;
    font-size: 14px;
    padding: 10px 14px;
    min-height: 42px;
}

#FormCombo:focus {
    border: 1px solid #38BDF8;
}

#FormCombo:hover {
    border: 1px solid #475569;
}

#FormCombo::drop-down {
    border: none;
    width: 32px;
}

#FormCombo QAbstractItemView {
    background-color: #1E293B;
    border: 1px solid #334155;
    border-radius: 8px;
    color: #F1F5F9;
    selection-background-color: #38BDF8;
    selection-color: #0B1121;
    padding: 4px;
}

/* Horizontal divider inside form card */
#FormDivider {
    color: #334155;
    background-color: #334155;
    max-height: 1px;
    border: none;
}

/* Inline validation error */
#InlineErrorLabel {
    font-size: 14px;
    font-weight: 500;
    color: #F87171;
    background-color: rgba(248, 113, 113, 0.08);
    border: 1px solid rgba(248, 113, 113, 0.25);
    border-radius: 8px;
    padding: 10px 16px;
}

/* Action buttons */
#PrimaryButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #0284C7, stop:1 #38BDF8);
    color: #0B1121;
    font-size: 14px;
    font-weight: 700;
    border: none;
    border-radius: 8px;
    padding: 0 24px;
    letter-spacing: 0.3px;
}

#PrimaryButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #0369A1, stop:1 #0284C7);
}

#PrimaryButton:pressed {
    background: #0284C7;
}

#SecondaryButton {
    background-color: transparent;
    color: #94A3B8;
    font-size: 14px;
    font-weight: 500;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 0 20px;
}

#SecondaryButton:hover {
    background-color: #1E293B;
    color: #F1F5F9;
    border: 1px solid #475569;
}

#SecondaryButton:pressed {
    background-color: #0F172A;
}

/* ====================================================
   PLACEHOLDER PAGE (chung cho các trang chưa làm)
   ==================================================== */

#PlaceholderPage {
    background-color: #0F172A;
}


/* ====================================================
   APP SHELL — role-aware sidebar & header (D-032)
   ==================================================== */

#Navigation::item:disabled {
    height: 30px;
    color: #475569;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.4px;
    padding-left: 8px;
    margin-bottom: 0px;
    background-color: transparent;
}

#HeaderNotice {
    font-size: 13px;
    font-weight: 600;
    color: #4ADE80;
    background-color: rgba(74, 222, 128, 0.10);
    border: 1px solid rgba(74, 222, 128, 0.30);
    border-radius: 14px;
    padding: 6px 14px;
}

#RoleBadge {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.2px;
    border-radius: 12px;
    padding: 6px 12px;
    color: #0B1121;
    background-color: #94A3B8;
}
#RoleBadge[role="admin"]     { background-color: #F472B6; }
#RoleBadge[role="inspector"] { background-color: #38BDF8; }
#RoleBadge[role="reviewer"]  { background-color: #FBBF24; }

#LogoutButton {
    background-color: transparent;
    color: #F87171;
    font-size: 13px;
    font-weight: 600;
    border: 1px solid rgba(248, 113, 113, 0.40);
    border-radius: 8px;
    padding: 0 16px;
}
#LogoutButton:hover {
    background-color: rgba(248, 113, 113, 0.12);
    border: 1px solid #F87171;
}

/* Pages share the content background */
#BoxIntakePage, #LiveInspectionPage, #AssessmentResultPage,
#ReviewQueuePage, #SettingsPage {
    background-color: #0F172A;
}

#PageScrollArea > QWidget#qt_scrollarea_viewport {
    background-color: transparent;
}

#PageTitleSmall {
    font-size: 28px;
    font-weight: bold;
    color: #F8FAFC;
}

/* ====================================================
   SHARED COMPONENTS
   ==================================================== */

#MockBadge {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.2px;
    color: #FBBF24;
    background-color: rgba(251, 191, 36, 0.10);
    border: 1px solid rgba(251, 191, 36, 0.35);
    border-radius: 6px;
    padding: 4px 8px;
}

#StatusBadge {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1px;
    border-radius: 12px;
    padding: 6px 14px;
    color: #CBD5E1;
    background-color: #334155;
}
#StatusBadge[tone="good"]     { color: #4ADE80; background-color: rgba(74, 222, 128, 0.12); }
#StatusBadge[tone="critical"] { color: #F87171; background-color: rgba(248, 113, 113, 0.12); }
#StatusBadge[tone="warning"]  { color: #FBBF24; background-color: rgba(251, 191, 36, 0.12); }
#StatusBadge[tone="info"]     { color: #38BDF8; background-color: rgba(56, 189, 248, 0.12); }

#KeyLabel {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    color: #64748B;
}

#ValueLabel {
    font-size: 15px;
    color: #F1F5F9;
}

#HintLabel {
    font-size: 13px;
    color: #64748B;
}

#PlaceholderList {
    font-size: 14px;
    color: #CBD5E1;
    line-height: 160%;
}

#WarningNote {
    font-size: 13px;
    font-weight: 500;
    color: #FBBF24;
    background-color: rgba(251, 191, 36, 0.08);
    border: 1px solid rgba(251, 191, 36, 0.25);
    border-radius: 8px;
    padding: 10px 14px;
}

#InfoBanner {
    background-color: rgba(56, 189, 248, 0.08);
    border: 1px solid rgba(56, 189, 248, 0.35);
    border-radius: 12px;
}
#InfoBannerText {
    font-size: 14px;
    font-weight: 500;
    color: #BAE6FD;
}

#ScanField {
    background-color: #0B1121;
    border: 2px solid #334155;
    border-radius: 10px;
    color: #F8FAFC;
    font-size: 20px;
    font-weight: 600;
    padding: 14px 18px;
    selection-background-color: #38BDF8;
    selection-color: #0F172A;
}
#ScanField:focus {
    border: 2px solid #38BDF8;
}

#FormSpin {
    background-color: #0F172A;
    border: 1px solid #334155;
    border-radius: 8px;
    color: #F1F5F9;
    font-size: 14px;
    padding: 8px 12px;
    min-height: 24px;
}
#FormSpin:focus {
    border: 1px solid #38BDF8;
}

#DangerButton {
    background-color: rgba(248, 113, 113, 0.12);
    color: #F87171;
    font-size: 14px;
    font-weight: 700;
    border: 1px solid rgba(248, 113, 113, 0.45);
    border-radius: 8px;
    padding: 0 20px;
}
#DangerButton:hover {
    background-color: rgba(248, 113, 113, 0.22);
}

#PassButton {
    background-color: rgba(74, 222, 128, 0.14);
    color: #4ADE80;
    font-size: 14px;
    font-weight: 700;
    border: 1px solid rgba(74, 222, 128, 0.45);
    border-radius: 8px;
    padding: 0 20px;
}
#PassButton:hover {
    background-color: rgba(74, 222, 128, 0.24);
}

#PrimaryButton:disabled, #SecondaryButton:disabled, #DangerButton:disabled,
#PassButton:disabled {
    background: #1E293B;
    color: #475569;
    border: 1px solid #1E293B;
}

/* Data table */
#DataTable {
    background-color: #0F172A;
    alternate-background-color: #131D31;
    color: #E2E8F0;
    border: 1px solid #334155;
    border-radius: 10px;
    font-size: 14px;
    selection-background-color: rgba(56, 189, 248, 0.25);
    selection-color: #F8FAFC;
    gridline-color: transparent;
}
#DataTable::item {
    padding-left: 10px;
}
#DataTable QHeaderView::section {
    background-color: #1E293B;
    color: #94A3B8;
    font-size: 12px;
    font-weight: 700;
    border: none;
    border-bottom: 1px solid #334155;
    padding: 10px;
}
#DataTable QTableCornerButton::section {
    background-color: #1E293B;
    border: none;
}

#ReviewSplitter::handle {
    background-color: #1E293B;
    width: 2px;
}

#EvidenceThumb {
    background-color: #0B1121;
    border: 1px solid #334155;
    border-radius: 8px;
    color: #64748B;
    font-size: 11px;
    font-weight: 700;
}

/* Settings connection checks */
#CheckStatus                  { font-size: 13px; color: #64748B; }
#CheckStatus[state="running"] { color: #38BDF8; }
#CheckStatus[state="ok"]      { color: #4ADE80; }
#CheckStatus[state="error"]   { color: #F87171; }

/* VLM Result Panel (schema 1.0) & Catalog */
#CatalogPage { background-color: #0F172A; }
#VlmValue    { font-size: 13px; font-weight: 500; color: #E2E8F0; }
#VlmCritical { font-size: 13px; font-weight: 700; color: #F87171; }
#VlmMismatch {
    font-size: 12px;
    font-weight: 700;
    color: #FBBF24;
    background-color: rgba(251, 191, 36, 0.14);
    border: 1px solid rgba(251, 191, 36, 0.45);
    border-radius: 6px;
    padding: 3px 8px;
}
#VlmErrorBox {
    background-color: rgba(248, 113, 113, 0.10);
    border: 1px solid rgba(248, 113, 113, 0.40);
    border-radius: 10px;
}
#VlmErrorTitle { font-size: 14px; font-weight: 700; color: #F87171; }
#VlmErrorText  { font-size: 13px; font-weight: 500; color: #FECACA; }
QCheckBox      { font-size: 13px; font-weight: 600; color: #E2E8F0; spacing: 8px; }

/* ====================================================
   LIVE INSPECTION
   ==================================================== */

#CameraFrame {
    background-color: #020617;
    border: 1px solid #334155;
    border-radius: 12px;
}
#NoCameraPanel {
    background-color: #020617;
}
#NoCameraIcon {
    font-size: 48px;
    color: #334155;
}
#NoCameraTitle {
    font-size: 22px;
    font-weight: 700;
    color: #F1F5F9;
}
#RealtimeValue {
    font-size: 44px;
    font-weight: 800;
    color: #38BDF8;
    min-height: 52px;
}

/* ====================================================
   LOGIN & DIALOGS
   ==================================================== */

#LoginDialog, #AppDialog, #DialogPage {
    background-color: #0F172A;
}
#LoginTitle {
    font-size: 26px;
    font-weight: 700;
    color: #F8FAFC;
}
#QuickLoginButton {
    background-color: #1E293B;
    color: #F1F5F9;
    font-size: 13px;
    font-weight: 600;
    border: 1px solid #334155;
    border-radius: 10px;
}
#QuickLoginButton:hover {
    background-color: #273449;
    border: 1px solid #38BDF8;
}
#LinkButton {
    background: transparent;
    border: none;
    color: #38BDF8;
    font-size: 13px;
    font-weight: 600;
}
#LinkButton:hover {
    color: #7DD3FC;
}

/* Scrollbars */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: #334155;
    border-radius: 4px;
    min-height: 32px;
}
QScrollBar::handle:vertical:hover {
    background: #475569;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
    height: 0;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}
QScrollBar::handle:horizontal {
    background: #334155;
    border-radius: 4px;
    min-width: 32px;
}
QScrollBar::handle:horizontal:hover {
    background: #475569;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
    width: 0;
}


/* ====================================================
   DATA IMPORT PAGE (3.1.5.7)
   ==================================================== */

#DataImportPage {
    background-color: #0F172A;
}

#ImportMetricCard {
    background-color: #1E293B;
    border: 1px solid #334155;
    border-radius: 12px;
}

#ImportMetricTitle {
    font-size: 11px;
    font-weight: 700;
    color: #94A3B8;
    letter-spacing: 1px;
}

#ImportMetricValue {
    font-size: 28px;
    font-weight: 800;
    color: #F8FAFC;
}

#ImportMetricValue[tone="good"] {
    color: #4ADE80;
}

#ImportMetricValue[tone="critical"] {
    color: #F87171;
}

#ImportSuccessLabel {
    font-size: 14px;
    font-weight: 600;
    color: #4ADE80;
    background-color: rgba(74, 222, 128, 0.12);
    border: 1px solid rgba(74, 222, 128, 0.35);
    border-radius: 8px;
    padding: 10px 16px;
}

#ImportEmptyState {
    font-size: 14px;
    font-weight: 500;
    color: #94A3B8;
    background-color: #0F172A;
    border: 1px dashed #334155;
    border-radius: 10px;
    padding: 20px;
}
