/* ====================================================
   AGROSCAN LIGHT & NAVY-BLUE THEME
   Clean white cards on cool slate-white canvas (#F4F7FB),
   deep navy sidebar (#0F1C35), royal blue accent (#2563EB).
   ==================================================== */

QWidget {
    font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", "Segoe UI Symbol", sans-serif;
}

QMainWindow,
QDialog,
QMessageBox {
    background-color: #F4F7FB;
    color: #0F172A;
}

QLabel {
    color: #1E293B;
    background-color: transparent;
}

QToolTip {
    background-color: #0F1C35;
    color: #F8FAFC;
    border: 1px solid #1E2E4F;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
}

/* ====================================================
   SIDEBAR (Deep Navy Rail)
   ==================================================== */

#Sidebar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #183059, stop:1 #132647);
    border-right: 1px solid #243C66;
}

/* Brand defaults for light surfaces (e.g., LoginDialog), overridden inside #Sidebar */
#Brand {
    font-size: 30px;
    font-weight: 900;
    color: #132647;
    letter-spacing: -1px;
}

#Sidebar #Brand {
    color: #FFFFFF;
}

#BrandSubtitle {
    font-size: 11px;
    font-weight: 700;
    color: #2563EB;
    letter-spacing: 1.5px;
}

#Sidebar #BrandSubtitle {
    color: #7DB4FB;
}

#Navigation {
    background-color: transparent;
    border: none;
    outline: none;
}

#Navigation::item {
    height: 44px;
    border-radius: 8px;
    color: #D5E1F2;
    font-size: 14px;
    font-weight: 500;
    padding-left: 16px;
    margin-bottom: 4px;
}

#Navigation::item:hover {
    background-color: #203A66;
    color: #FFFFFF;
}

#Navigation::item:selected {
    background-color: #285FA6;
    border: 1px solid #3F7AC6;
    color: #FFFFFF;
    font-weight: 700;
}

#Navigation::item:disabled {
    height: 30px;
    color: #8EA3C2;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.4px;
    padding-left: 8px;
    margin-bottom: 0px;
    background-color: transparent;
}

#DemoBadge {
    background-color: #FEF3C7;
    color: #B45309;
    border: 1px solid #FDE68A;
    font-size: 11px;
    font-weight: 700;
    padding: 8px 14px;
    border-radius: 6px;
    letter-spacing: 1.2px;
}

#Sidebar #DemoBadge {
    background-color: #1D355E;
    color: #A8CCFC;
    border: 1px solid #2F4F82;
    padding: 10px 16px;
}

/* ====================================================
   HEADER & CONTENT CANVAS
   ==================================================== */

#Content,
#DashboardPage,
#BoxIntakePage,
#LiveInspectionPage,
#AssessmentResultPage,
#ReviewQueuePage,
#CatalogPage,
#SettingsPage,
#PlaceholderPage,
#NewInspectionPage {
    background-color: #F4F7FB;
}

#Header {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E2E8F0;
}

#Breadcrumb {
    font-size: 14px;
    font-weight: 600;
    color: #475569;
}

#HeaderNotice {
    font-size: 13px;
    font-weight: 600;
    color: #15803D;
    background-color: #DCFCE7;
    border: 1px solid #86EFAC;
    border-radius: 14px;
    padding: 6px 14px;
}

#UserLabel {
    font-size: 13px;
    font-weight: 700;
    color: #0F172A;
    background-color: #F1F5F9;
    border: 1px solid #E2E8F0;
    padding: 7px 18px;
    border-radius: 16px;
}

#RoleBadge {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.1px;
    border-radius: 12px;
    padding: 6px 12px;
    color: #334155;
    background-color: #E2E8F0;
    border: 1px solid #CBD5E1;
}
#RoleBadge[role="admin"] {
    background-color: #DBEAFE;
    color: #1D4ED8;
    border: 1px solid #BFDBFE;
}
#RoleBadge[role="inspector"] {
    background-color: #E0F2FE;
    color: #0369A1;
    border: 1px solid #BAE6FD;
}
#RoleBadge[role="reviewer"] {
    background-color: #FEF3C7;
    color: #B45309;
    border: 1px solid #FDE68A;
}

#LogoutButton {
    background-color: #FFFFFF;
    color: #DC2626;
    font-size: 13px;
    font-weight: 600;
    border: 1px solid #FECACA;
    border-radius: 8px;
    padding: 0 16px;
}
#LogoutButton:hover {
    background-color: #FEF2F2;
    border: 1px solid #F87171;
}
#LogoutButton:pressed {
    background-color: #FEE2E2;
}

#PageScrollArea {
    background-color: transparent;
    border: none;
}

#PageScrollArea > QWidget#qt_scrollarea_viewport {
    background-color: transparent;
}

#ScrollContent {
    background-color: transparent;
}

/* ====================================================
   TYPOGRAPHY & STAT CARDS
   ==================================================== */

#PageTitle {
    font-size: 36px;
    font-weight: 800;
    color: #0F172A;
    letter-spacing: -0.5px;
}

#PageTitleSmall {
    font-size: 28px;
    font-weight: 800;
    color: #0F172A;
}

#PageSubtitle {
    font-size: 15px;
    color: #64748B;
}

#StatCard {
    background-color: #FFFFFF;
    border-radius: 14px;
    border: 1px solid #E2E8F0;
}

#StatCard:hover {
    background-color: #FFFFFF;
    border: 1px solid #93C5FD;
}

#CardTitle {
    font-size: 12px;
    font-weight: 700;
    color: #64748B;
    letter-spacing: 1px;
}

#CardValue {
    font-size: 42px;
    font-weight: 800;
    color: #0F172A;
}

#CardNote {
    font-size: 13px;
    font-weight: 500;
    color: #64748B;
}

/* ====================================================
   LOADING TRANSITION SCREEN
   ==================================================== */

#LoadingContainer {
    background-color: #F4F7FB;
}

#LoadingCard {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 20px;
}

#LoadingTitle {
    font-size: 22px;
    font-weight: 700;
    color: #0F172A;
    letter-spacing: -0.3px;
}

#LoadingStatus {
    font-size: 13px;
    font-weight: 600;
    color: #2563EB;
}

#LoadingProgressBar {
    background-color: #E2E8F0;
    border: none;
    border-radius: 4px;
    text-align: center;
    color: transparent;
    height: 8px;
}

#LoadingProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #2563EB, stop:1 #60A5FA);
    border-radius: 4px;
}

#LoadingSubtitle {
    font-size: 13px;
    font-weight: 500;
    color: #64748B;
}

/* ====================================================
   CARDS, FORMS & INPUTS
   ==================================================== */

#FormCard {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 14px;
}

#FormSectionTitle {
    font-size: 12px;
    font-weight: 700;
    color: #2563EB;
    letter-spacing: 1.2px;
}

#FormLabel {
    font-size: 14px;
    font-weight: 600;
    color: #334155;
    min-width: 148px;
}

#FormField,
#ReadOnlyField,
#NotesField {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    color: #0F172A;
    font-size: 14px;
    padding: 10px 14px;
    selection-background-color: #2563EB;
    selection-color: #FFFFFF;
}

#FormField:hover,
#NotesField:hover {
    border: 1px solid #94A3B8;
}

#FormField:focus,
#NotesField:focus {
    border: 1px solid #2563EB;
    background-color: #FFFFFF;
}

#ReadOnlyField {
    color: #64748B;
    background-color: #F8FAFC;
    border: 1px solid #E2E8F0;
}

#ScanField {
    background-color: #FFFFFF;
    border: 2px solid #93C5FD;
    border-radius: 10px;
    color: #0F172A;
    font-size: 20px;
    font-weight: 700;
    padding: 14px 18px;
    selection-background-color: #2563EB;
    selection-color: #FFFFFF;
}
#ScanField:hover {
    border: 2px solid #60A5FA;
}
#ScanField:focus {
    border: 2px solid #2563EB;
    background-color: #F8FAFF;
}

#FormCombo {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    color: #0F172A;
    font-size: 14px;
    padding: 8px 14px;
    min-height: 24px;
}
#FormCombo:hover {
    border: 1px solid #94A3B8;
}
#FormCombo:focus {
    border: 1px solid #2563EB;
}
#FormCombo::drop-down {
    border: none;
    width: 32px;
}
#FormCombo QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    color: #0F172A;
    selection-background-color: #DBEAFE;
    selection-color: #1E3A8A;
    padding: 4px;
}

#FormSpin {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    color: #0F172A;
    font-size: 14px;
    padding: 8px 12px;
    min-height: 24px;
    selection-background-color: #2563EB;
    selection-color: #FFFFFF;
}
#FormSpin:hover {
    border: 1px solid #94A3B8;
}
#FormSpin:focus {
    border: 1px solid #2563EB;
}

#FormDivider {
    color: #E2E8F0;
    background-color: #E2E8F0;
    max-height: 1px;
    border: none;
}

/* ====================================================
   BUTTONS
   ==================================================== */

#PrimaryButton {
    background-color: #2563EB;
    color: #FFFFFF;
    font-size: 14px;
    font-weight: 700;
    border: none;
    border-radius: 8px;
    padding: 0 24px;
    letter-spacing: 0.2px;
}
#PrimaryButton:hover {
    background-color: #1D4ED8;
}
#PrimaryButton:pressed {
    background-color: #1E40AF;
}

#SecondaryButton {
    background-color: #FFFFFF;
    color: #334155;
    font-size: 14px;
    font-weight: 600;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    padding: 0 20px;
}
#SecondaryButton:hover {
    background-color: #F8FAFC;
    color: #0F172A;
    border: 1px solid #94A3B8;
}
#SecondaryButton:pressed {
    background-color: #F1F5F9;
}

#PassButton {
    background-color: #ECFDF5;
    color: #059669;
    font-size: 14px;
    font-weight: 700;
    border: 1px solid #6EE7B7;
    border-radius: 8px;
    padding: 0 20px;
}
#PassButton:hover {
    background-color: #D1FAE5;
    border: 1px solid #34D399;
}

#DangerButton {
    background-color: #FEF2F2;
    color: #DC2626;
    font-size: 14px;
    font-weight: 700;
    border: 1px solid #FCA5A5;
    border-radius: 8px;
    padding: 0 20px;
}
#DangerButton:hover {
    background-color: #FEE2E2;
    border: 1px solid #F87171;
}

#PrimaryButton:disabled,
#SecondaryButton:disabled,
#DangerButton:disabled,
#PassButton:disabled {
    background-color: #F1F5F9;
    color: #94A3B8;
    border: 1px solid #E2E8F0;
}

QMessageBox QPushButton {
    background-color: #FFFFFF;
    color: #1E293B;
    font-size: 13px;
    font-weight: 600;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding: 6px 18px;
    min-width: 72px;
}
QMessageBox QPushButton:hover {
    background-color: #EFF6FF;
    border: 1px solid #2563EB;
    color: #1D4ED8;
}

/* ====================================================
   BADGES, BANNERS & READ-ONLY DISPLAY
   ==================================================== */

#MockBadge {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.2px;
    color: #B45309;
    background-color: #FEF3C7;
    border: 1px solid #FDE68A;
    border-radius: 6px;
    padding: 4px 8px;
}

#StatusBadge {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.8px;
    border-radius: 12px;
    padding: 5px 14px;
    color: #475569;
    background-color: #F1F5F9;
    border: 1px solid #E2E8F0;
}
#StatusBadge[tone="good"] {
    color: #15803D;
    background-color: #DCFCE7;
    border: 1px solid #BBF7D0;
}
#StatusBadge[tone="critical"] {
    color: #B91C1C;
    background-color: #FEE2E2;
    border: 1px solid #FECACA;
}
#StatusBadge[tone="warning"] {
    color: #B45309;
    background-color: #FEF3C7;
    border: 1px solid #FDE68A;
}
#StatusBadge[tone="info"] {
    color: #1D4ED8;
    background-color: #DBEAFE;
    border: 1px solid #BFDBFE;
}

#KeyLabel {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    color: #64748B;
}

#ValueLabel {
    font-size: 15px;
    font-weight: 500;
    color: #0F172A;
}

#HintLabel {
    font-size: 13px;
    color: #64748B;
}

#PlaceholderList {
    font-size: 14px;
    color: #334155;
    line-height: 160%;
}

#InlineErrorLabel {
    font-size: 14px;
    font-weight: 600;
    color: #DC2626;
    background-color: #FEF2F2;
    border: 1px solid #FECACA;
    border-radius: 8px;
    padding: 10px 16px;
}

#WarningNote {
    font-size: 13px;
    font-weight: 600;
    color: #B45309;
    background-color: #FFFBEB;
    border: 1px solid #FDE68A;
    border-radius: 8px;
    padding: 10px 14px;
}

#InfoBanner {
    background-color: #EFF6FF;
    border: 1px solid #BFDBFE;
    border-radius: 12px;
}
#InfoBannerText {
    font-size: 14px;
    font-weight: 600;
    color: #1E40AF;
}

/* VLM Result Panel (schema 1.0) */
#VlmValue {
    font-size: 13px;
    font-weight: 500;
    color: #0F172A;
}

#VlmCritical {
    font-size: 13px;
    font-weight: 700;
    color: #B91C1C;
}

#VlmMismatch {
    font-size: 12px;
    font-weight: 700;
    color: #B45309;
    background-color: #FFFBEB;
    border: 1px solid #FDE68A;
    border-radius: 6px;
    padding: 3px 8px;
}

#VlmErrorBox {
    background-color: #FEF2F2;
    border: 1px solid #FECACA;
    border-radius: 10px;
}

#VlmErrorTitle {
    font-size: 14px;
    font-weight: 700;
    color: #B91C1C;
}

#VlmErrorText {
    font-size: 13px;
    font-weight: 500;
    color: #7F1D1D;
}

QCheckBox {
    font-size: 13px;
    font-weight: 600;
    color: #1E293B;
    spacing: 8px;
}

/* ====================================================
   DATA TABLE, SPLITTER & EVIDENCE STRIP
   ==================================================== */

#DataTable {
    background-color: #FFFFFF;
    alternate-background-color: #F8FAFC;
    color: #1E293B;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
    font-size: 14px;
    selection-background-color: #DBEAFE;
    selection-color: #1E3A8A;
    gridline-color: transparent;
}
#DataTable::item {
    padding-left: 10px;
    border-bottom: 1px solid #F1F5F9;
}
#DataTable::item:selected {
    background-color: #DBEAFE;
    color: #1E3A8A;
}
#DataTable QHeaderView {
    background-color: #F8FAFC;
    border: none;
}
#DataTable QHeaderView::section,
#DataTable QHeaderView::section:checked,
#DataTable QHeaderView::section:pressed {
    background-color: #F8FAFC;
    color: #64748B;
    font-size: 12px;
    font-weight: 700;
    border-style: solid;
    border-width: 0px 0px 1px 0px;
    border-color: #E2E8F0;
    padding: 10px;
}
#DataTable QHeaderView::section:hover {
    background-color: #F1F5F9;
    color: #334155;
}
#DataTable QTableCornerButton::section {
    background-color: #F8FAFC;
    border: none;
}

#ReviewSplitter::handle {
    background-color: #E2E8F0;
    width: 2px;
}

#EvidenceThumb {
    background-color: #F8FAFC;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    color: #64748B;
    font-size: 11px;
    font-weight: 700;
}

/* Settings connection checks */
#CheckStatus                  { font-size: 13px; color: #64748B; }
#CheckStatus[state="running"] { color: #2563EB; font-weight: 600; }
#CheckStatus[state="ok"]      { color: #15803D; font-weight: 600; }
#CheckStatus[state="error"]   { color: #DC2626; font-weight: 600; }

/* ====================================================
   LIVE INSPECTION CAMERA VIEWPORT
   Keep camera viewport dark so produce stands out clearly.
   ==================================================== */

#CameraFrame {
    background-color: #0F172A;
    border: 1px solid #CBD5E1;
    border-radius: 12px;
}
#NoCameraPanel {
    background-color: #0F172A;
}
#NoCameraIcon {
    font-size: 48px;
    color: #475569;
}
#NoCameraTitle {
    font-size: 22px;
    font-weight: 700;
    color: #F8FAFC;
}
#NoCameraPanel #PageSubtitle {
    color: #94A3B8;
}
#NoCameraPanel #SecondaryButton {
    background-color: #1E293B;
    color: #F1F5F9;
    border: 1px solid #334155;
}
#NoCameraPanel #SecondaryButton:hover {
    background-color: #334155;
    border: 1px solid #60A5FA;
}

#RealtimeValue {
    font-size: 44px;
    font-weight: 800;
    color: #2563EB;
    min-height: 52px;
}

/* ====================================================
   LOGIN & DIALOGS
   ==================================================== */

#LoginDialog,
#AppDialog,
#DialogPage {
    background-color: #F4F7FB;
}

#LoginTitle {
    font-size: 26px;
    font-weight: 800;
    color: #0F172A;
}

#QuickLoginButton {
    background-color: #FFFFFF;
    color: #0F172A;
    font-size: 13px;
    font-weight: 600;
    border: 1px solid #CBD5E1;
    border-radius: 10px;
}
#QuickLoginButton:hover {
    background-color: #EFF6FF;
    color: #1D4ED8;
    border: 1px solid #2563EB;
}
#QuickLoginButton:pressed {
    background-color: #DBEAFE;
}

#LinkButton {
    background: transparent;
    border: none;
    color: #2563EB;
    font-size: 13px;
    font-weight: 600;
}
#LinkButton:hover {
    color: #1D4ED8;
}

/* ====================================================
   SCROLLBARS
   ==================================================== */

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: #CBD5E1;
    border-radius: 4px;
    min-height: 32px;
}
QScrollBar::handle:vertical:hover {
    background: #94A3B8;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}
QScrollBar::handle:horizontal {
    background: #CBD5E1;
    border-radius: 4px;
    min-width: 32px;
}
QScrollBar::handle:horizontal:hover {
    background: #94A3B8;
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
    width: 0;
}

/* Keep scrollbar subtle inside dark sidebar */
#Sidebar QScrollBar::handle:vertical {
    background: #253B63;
}
#Sidebar QScrollBar::handle:vertical:hover {
    background: #3B5998;
}


/* ====================================================
   DATA IMPORT PAGE (3.1.5.7)
   ==================================================== */

#DataImportPage {
    background-color: #F4F7FB;
}

#ImportMetricCard {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
}

#ImportMetricTitle {
    font-size: 11px;
    font-weight: 700;
    color: #64748B;
    letter-spacing: 1px;
}

#ImportMetricValue {
    font-size: 28px;
    font-weight: 800;
    color: #0F172A;
}

#ImportMetricValue[tone="good"] {
    color: #15803D;
}

#ImportMetricValue[tone="critical"] {
    color: #DC2626;
}

#ImportSuccessLabel {
    font-size: 14px;
    font-weight: 600;
    color: #15803D;
    background-color: #F0FDF4;
    border: 1px solid #BBF7D0;
    border-radius: 8px;
    padding: 10px 16px;
}

#ImportEmptyState {
    font-size: 14px;
    font-weight: 500;
    color: #64748B;
    background-color: #F8FAFC;
    border: 1px dashed #CBD5E1;
    border-radius: 10px;
    padding: 20px;
}
