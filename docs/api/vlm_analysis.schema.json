{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agroscan.local/schemas/vlm_analysis/1.0",
  "title": "AgroScan VLM Deep Analysis Result",
  "description": "Response body of POST /api/v1/vlm/analyze (Qwen-VL service, D-017). Advisory only: never overrides YOLO counts or the rule-engine recommendation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "status",
    "model",
    "latency_ms",
    "analyzed_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "request_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "ok",
        "partial",
        "error"
      ]
    },
    "model": {
      "type": "string"
    },
    "latency_ms": {
      "type": "integer",
      "minimum": 0
    },
    "analyzed_at": {
      "type": "string",
      "format": "date-time"
    },
    "defects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "defect_class",
          "count",
          "severity",
          "confidence"
        ],
        "properties": {
          "defect_class": {
            "type": "string",
            "minLength": 1
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "severity": {
            "enum": [
              "minor",
              "major",
              "critical"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "description": {
            "type": "string"
          },
          "region": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "minItems": 4,
            "maxItems": 4
          }
        }
      }
    },
    "ocr": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "readable",
        "fields"
      ],
      "properties": {
        "readable": {
          "type": "boolean"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "value",
              "confidence"
            ],
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string"
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "raw_text": {
          "type": "string"
        }
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assessment": {
      "type": "string"
    },
    "uncertainty": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "level",
        "score"
      ],
      "properties": {
        "level": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "suggestion": {
      "type": "string"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "error": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "enum": [
            "TIMEOUT",
            "SERVICE_UNAVAILABLE",
            "INVALID_RESPONSE",
            "IMAGE_UNUSABLE",
            "MODEL_ERROR"
          ]
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "error"
          }
        }
      },
      "then": {
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object"
          }
        }
      },
      "else": {
        "required": [
          "uncertainty"
        ],
        "properties": {
          "error": {
            "type": "null"
          },
          "uncertainty": {
            "type": "object"
          }
        }
      }
    }
  ]
}
